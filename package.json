{
  "name": "agentloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "npm run build && tsx tests/support/run-ui.ts",
    "test:jev-ui": "npm run build && node scripts/test-jev-ui.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:unit": "tsx tests/support/run-tests.ts unit",
    "test:integration": "tsx tests/support/run-tests.ts integration",
    "test:watch": "tsx tests/support/run-tests.ts watch",
    "test:coverage": "tsx tests/support/run-tests.ts coverage",
    "test:ui:docker": "docker compose -p agentloom-tests -f compose.tests.yaml run --build --rm browser"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@modelcontextprotocol/server": "2.0.0",
    "fastify": "5.12.5",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "c8": "12.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  }
}
