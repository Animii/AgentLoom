# Optional API credentials. Leave blank to use CLI login in the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional Jev fallback. You can instead save it under Agents > Jev.
TYPESAFE_API_KEY=
# Host directory containing projects/ and runs/. Default: ./workspaces
WORKSPACE_ROOT=./workspaces
# Host directory available to the connected-folder browser. Default: parent Projects folder.
PROJECTS_FOLDER=..
PORT=4317

# Total agent turn limit: 1 hour. Idle limit: 10 minutes (0 disables idle detection).
CLI_TIMEOUT_MS=3600000
CLI_IDLE_TIMEOUT_MS=600000
